.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.swp
Thumbs.db

# the real member list for `pnpm db:seed` (local only)
# seed-data-example.json stays committed - it is the sample that documents the format.
seed-data.json

# Vercel: the project link and token `vercel link` generates (a different value per machine)
.vercel/

# misc
.cache/
.turbo/
*.pem

# Local approval marker written by the pr-review skill — per-developer state,
# never shared: a committed marker would hand everyone an approval they never made.
.claude/.pr-review-passed

# business notes, not part of the app
ba.md
