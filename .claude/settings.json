{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-push-review-gate.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-edit.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-on-stop.sh\"",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "design-taste-frontend": "user-invocable-only",
    "minimalist-ui": "user-invocable-only",
    "redesign-existing-projects": "user-invocable-only",
    "web-design-guidelines": "user-invocable-only"
  }
}
