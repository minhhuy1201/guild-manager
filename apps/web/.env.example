# Secret used to verify the JWT signed by apps/api (HMAC-SHA256).
# Must MATCH AUTH_SECRET in apps/api — admin accounts are configured on the backend
# (DISCORD_CLIENT_ID/DISCORD_CLIENT_SECRET); the web app only verifies the token it receives.
# Generate one: openssl rand -hex 32
AUTH_SECRET=

# Base URL of the backend API (apps/api).
NEXT_PUBLIC_API_URL=http://localhost:3001/api
