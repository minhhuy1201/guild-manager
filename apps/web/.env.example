# Khóa bí mật dùng verify JWT do apps/api ký (HMAC-SHA256).
# Phải TRÙNG giá trị AUTH_SECRET của apps/api — tài khoản quản trị giờ cấu hình ở backend
# (ADMIN_USERNAMES/ADMIN_PASSWORD), web chỉ verify token nhận được.
# Sinh khóa mới: openssl rand -hex 32
AUTH_SECRET=

# Base URL của backend API (apps/api).
NEXT_PUBLIC_API_URL=http://localhost:3001/api
