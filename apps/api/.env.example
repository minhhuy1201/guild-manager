# Runtime environment: development | production | test
NODE_ENV=development

# API port (3001 by default, to stay clear of Next.js on 3000).
PORT=3001

# PostgreSQL connection string for Prisma — read by both the runtime and the CLI.
# On Supabase this is the pooler port (6543): the free tier caps direct connections.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guild_manager?schema=public

# Connection used by `pnpm migrate:prod` and `pnpm db:seed`. Deliberately absent from
# src/config/env.validation.ts: the runtime must never touch it. Leave empty on local Postgres.
#
# Append `?connect_timeout=30` when pointing at Supabase: the Prisma CLI gives up after 5 seconds,
# and a cold connection from VN to the Tokyo region can take 9 — it shows up as intermittent P1001.
# The runtime is unaffected because @prisma/adapter-pg does not set such a short timeout.
DIRECT_DATABASE_URL=

# Dev PostgreSQL container (docker-compose.yml) — must match DATABASE_URL above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=guild_manager
POSTGRES_PORT=5432

# Frontend origin, used for CORS.
WEB_ORIGIN=http://localhost:3000

# Vercel project name of the web app. When set, CORS also accepts the preview domains
# https://<name>-….vercel.app. Leave empty for local or non-Vercel hosting.
WEB_PREVIEW_PROJECT=

# JWT signing secret (access + refresh) — must be the SAME value as AUTH_SECRET in apps/web.
# Generate one: openssl rand -hex 32
AUTH_SECRET=

# Discord OAuth2 — from https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback
# Rescue Discord IDs (comma-separated) — always granted ADMIN access
DISCORD_ADMIN_IDS=

# Discord bot — General Information → Public Key. 64 hex characters. Verifies that an interaction
# webhook really came from Discord; the API refuses to boot without it.
DISCORD_PUBLIC_KEY=

# Guild role mentioned by /thong-bao. Enable Developer Mode, then Server Settings → Roles →
# right-click the role → Copy Role ID. Required: a missing value kills the API at boot.
DISCORD_GUILD_ROLE_ID=

# Channels the /chao-mung welcome message points a new member at. Enable Developer Mode, then
# right-click the channel → Copy Channel ID. All three required: a missing value kills the API at
# boot, which beats posting a welcome that links to <#undefined>.
DISCORD_BANG_CHIEN_CHANNEL_ID=
DISCORD_NGHICH_THUY_HAN_CHANNEL_ID=
DISCORD_KHAM_ACC_CHANNEL_ID=

# Channel #🤒│báo-bận — the formation announcement links here for whoever cannot make it.
# Required: a missing value kills the API at boot.
DISCORD_BAO_BAN_CHANNEL_ID=

# Bot token — Bot → Reset Token. Shown exactly once. Read by `discord:register` AND by the running
# app, which posts the daily attendance reminder with it. Local and production are two different
# Discord Applications, so .env.production carries its own token.
# Required: a missing value kills the API at boot.
DISCORD_BOT_TOKEN=

# Secret for the cron endpoint that posts the attendance reminder. Vercel sends it as
# `Authorization: Bearer <secret>` on the scheduled call; the guard rejects everything else. At
# least 32 characters — generate one: openssl rand -hex 32
# Cron does not run locally, so any value of the right length does here.
CRON_SECRET=

# Read only by `pnpm --filter api discord:register`, never by the running app — which is why it is
# not in env.validation.ts. It is selected per command alongside the token above:
#   DISCORD_ENV_FILE=.env.production pnpm --filter api discord:register
# Discord server id. Enable Developer Mode, then right-click the server name → Copy Server ID.
DISCORD_GUILD_ID=

# Timezone used for attendance deadlines (see docs/architecture.md §6).
APP_TIMEZONE=Asia/Ho_Chi_Minh
