# Môi trường chạy: development | production | test
NODE_ENV=development

# Port của API (mặc định 3001 để không đụng Next.js ở 3000).
PORT=3001

# Connection string PostgreSQL cho Prisma — cả runtime lẫn CLI đều đọc biến này.
# Khi host trên Supabase, đây là cổng pooler (6543) vì gói free giới hạn kết nối trực tiếp.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guild_manager?schema=public

# Kết nối trực tiếp (Supabase: cổng 5432), CHỈ dùng cho `pnpm migrate:prod`.
# `prisma migrate` cần advisory lock và transaction nên không chạy qua pooler được.
# Cố tình không khai báo trong src/config/env.validation.ts: runtime không được đụng tới biến này,
# nếu không app sẽ lặng lẽ bỏ qua pooler. Để trống khi chạy Postgres local.
DIRECT_DATABASE_URL=

# Thông tin container PostgreSQL dev (docker-compose.yml) — phải khớp với DATABASE_URL ở trên.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=guild_manager
POSTGRES_PORT=5432

# Origin của frontend, dùng cho CORS.
WEB_ORIGIN=http://localhost:3000

# Khóa bí mật ký JWT (access + refresh) — dùng CHUNG giá trị với apps/web (AUTH_SECRET).
# Sinh khóa mới: openssl rand -hex 32
AUTH_SECRET=

# Các tài khoản toàn quyền admin, phân tách bằng dấu phẩy (so khớp không phân biệt hoa thường).
ADMIN_USERNAMES=huy,leonie

# Mật khẩu dùng chung cho các tài khoản admin ở trên.
ADMIN_PASSWORD=testne

# Múi giờ tính deadline điểm danh (xem apps/web/docs/attendance-time-rules.md).
APP_TIMEZONE=Asia/Ho_Chi_Minh
