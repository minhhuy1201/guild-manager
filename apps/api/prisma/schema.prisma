// Prisma schema — single source of truth for the Guild Manager data model.
// Domain and time rules are summarised in docs/architecture.md sections 5-6.

// The app runs CommonJS (NestJS), so the client must be generated as cjs;
// otherwise jest/ts-node break on `import.meta` in the generated code.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  runtime             = "nodejs"
  // Extensionless import so ts-node (the seed script) can resolve it, not just webpack/jest.
  importFileExtension = ""
}

// The connection URL is declared in prisma.config.ts (Prisma 7 no longer accepts `url` in the schema).
datasource db {
  provider = "postgresql"
}

/// Character class. Values must match the GuildClass enum in packages/shared/enums.
enum GuildClass {
  CUU_LINH
  HUYET_HA
  LONG_NGAM
  THAN_TUONG
  THIET_Y
  TOAI_MONG
  TO_VAN
}

/// Guild role. Values must match the GuildRole enum in packages/shared/enums.
enum GuildRole {
  ADMIN
  MEMBER
}

/// A character in the guild.
model Character {
  /// Generated primary key: name slug plus a random suffix ("meo-beo-k7ma3x").
  id              String     @id
  /// Display name of the character.
  name            String
  guildClass      GuildClass
  /// Discord ID (snowflake) entered by an admin. Null = this member cannot sign in yet.
  /// Nullable + @unique: Postgres allows many NULLs, so "many unassigned" is valid while
  /// "two people on one ID" is not.
  discordId       String?    @unique
  /// Discord name read at the last login — lets an admin confirm the right person was assigned.
  discordUsername String?
  /// Discord avatar hash read at the last login (hash only, not a URL).
  /// A hash, not a URL: the CDN URL format is Discord's business and can change without notice.
  discordAvatar   String?
  /// Null = never signed in.
  lastLoginAt     DateTime?
  role            GuildRole  @default(MEMBER)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  attendanceRecords AttendanceRecord[]
  formationSlots    FormationSlot[]

  @@index([guildClass])
}

/// A battle in the week. Guild War is system-generated, scrims are entered by admins.
model BattleSession {
  /// Guild War uses the deterministic id `gw-<weekStart YYYY-MM-DD>` for an idempotent upsert;
  /// admin-created scrims use the default cuid().
  id         String   @id @default(cuid())
  /// When the battle takes place.
  dateTime   DateTime
  /// Attendance deadline. Scrim: set by an admin, at most 10:00 on the battle day
  /// (the backend rejects rather than clamps). Guild War: system-set to 17:00 Thursday
  /// of the same week, not editable.
  deadline   DateTime
  /// Opponent guild name. Null for a Guild War and for a scrim with no opponent yet.
  opponent   String?
  /// A Guild War session — system-generated, cannot be deleted.
  isGuildWar Boolean  @default(false)
  /// How many matches are played on this day, 1 or 2. The cap lives in Zod, not here — the same
  /// rule FormationMatch.matchIndex follows. Scrim: an admin's value, defaulting to 2.
  /// Guild War: system-owned, alternating 2/1 per week (see session-schedule.ts).
  matchCount Int      @default(2)
  /// Monday 00:00 of the week containing this session — used to group sessions by week.
  weekStart  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attendanceRecords AttendanceRecord[]
  /// The matches of this day (1 or 2), one formation each.
  formationMatches  FormationMatch[]

  @@index([weekStart])
}

/// One character's attendance for one battle session.
model AttendanceRecord {
  id                  String           @id @default(cuid())
  characterId         String
  sessionId           String
  /// True = "Có" (signed up), false = "Không".
  isPresent           Boolean
  /// Last time attendance was recorded (flipping yes ⇄ no before the deadline updates it).
  markedAt            DateTime         @default(now())
  /// Who recorded this entry. Null for data written before login existed.
  /// Deliberately not a relation: deleting the recorder must not destroy someone else's entry.
  markedByCharacterId String?
  /// Why the member answered "Không". Null when isPresent = true, or when no reason was given.
  /// VarChar(255) so the business limit cannot be bypassed by any write path.
  reason              String?          @db.VarChar(255)

  character Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  session   BattleSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([characterId, sessionId])
  @@index([sessionId])
}

/// One-time code the web app trades for a JWT pair once the API finished the OAuth callback.
/// Lives 60 seconds; expired rows are swept during the next exchange.
model AuthExchange {
  /// 32 random base64url bytes — the exact value handed to the web app via the URL.
  id        String    @id
  /// Stores discordId rather than a foreign key: a rescue admin may match no Character.
  discordId String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

/// One match within a battle day (at most 2 — the cap lives in Zod, not here).
/// The row exists even when nobody is placed yet: that is how "this day has 2 matches"
/// differs from "match 2 is empty".
model FormationMatch {
  id         String @id @default(cuid())
  sessionId  String
  /// 1 or 2. Assigned by the backend from the array position, never taken from the client.
  matchIndex Int

  session BattleSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  slots   FormationSlot[]

  @@unique([sessionId, matchIndex])
}

/// A slot with an occupant OR a note. A slot that is both empty and note-less has NO row.
/// That rule is code in `src/modules/team-builder/formation-grid.ts` — both read and write.
model FormationSlot {
  matchId     String
  /// "team-1-pos-1" — the grid layout itself stays entirely in the frontend.
  slotId      String
  /// Null when the slot only carries a note and nobody is placed yet ("reserved for X").
  characterId String?
  /// The team builder's note for this slot. Null when there is none.
  note        String?

  match     FormationMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  character Character?     @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([matchId, slotId])
  @@index([characterId])
}

/// Display name of one team column in the war formation. Global configuration: the same names
/// apply to every week, every battle day and every match — unlike FormationSlot, which is per
/// match. A team still showing its plain number has NO row.
model TeamName {
  /// Team number as the frontend numbers its columns (1..10 today). The backend never interprets
  /// it: the grid layout lives entirely in the frontend, exactly like `FormationSlot.slotId`.
  team      Int      @id
  name      String
  updatedAt DateTime @updatedAt
}

/// A Discord channel the bot posts to, keyed by what it posts there.
///
/// Global configuration like TeamName, hanging off nothing: it is not a property of a week, a
/// member or a session. Today it holds exactly one row, `ATTENDANCE_REMINDER`.
///
/// `purpose` is a String and NOT a Prisma enum on purpose: every enum in this schema has to stay in
/// step with `packages/shared/enums`, and this value never crosses the network to the web app — so
/// making it carry that obligation buys nothing.
model BotChannel {
  purpose   String   @id
  /// Discord channel id (a snowflake), written by /cau-hinh-kenh.
  channelId String
  updatedAt DateTime @updatedAt
}
