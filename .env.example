# Read by docker-compose.yml only — copy to `.env` if the defaults below do not suit you.
# Every value has the same default in the compose file, so the file is optional.
#
# These credentials must agree with DATABASE_URL in apps/api/.env: inside the `dev` profile the API
# builds its own connection string from them, but the host-side Prisma CLI (prisma:migrate,
# db:seed, prisma:studio) reads apps/api/.env and connects over the published port below.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=guild_manager

# Host port the database is published on. Change it when 5432 is already taken, and change the port
# in DATABASE_URL to match.
POSTGRES_PORT=5432
